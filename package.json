{
  "name": "mystic-lore-studio",
  "private": true,
  "version": "0.0.0",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:beta": "vite --mode beta",
    "build": "tsc -b && vite build",
    "build:beta": "tsc -b && vite build --mode beta",
    "db:reset": "supabase db reset --local --no-seed",
    "db:start": "supabase start",
    "dev:local": "node scripts/start-local-supabase-app.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:db": "supabase test db",
    "test:rc:migration": "node scripts/run-local-rc-migration.mjs",
    "test:canonical:integration": "vitest run tests/canonicalPersistence.test.ts",
    "test:e2e": "playwright test tests/e2e/studio.spec.ts",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "test:visual": "playwright test tests/e2e/wp11-visual.spec.ts tests/e2e/wp11d-visual.spec.ts tests/e2e/wp11e-visual.spec.ts tests/e2e/wp11f-visual.spec.ts",
    "check:scripts": "tsc -p tsconfig.scripts.json --pretty false",
    "beta:import-device": "sh scripts/run-beta-import.sh",
    "audit:beta": "tsx scripts/audit-beta.ts",
    "test:bundle": "node scripts/check-bundle-budget.mjs",
    "validate:schema": "node scripts/validate-ml-studio-2-schema.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@fontsource/cinzel-decorative": "^5.2.8",
    "@supabase/supabase-js": "^2.108.2",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.17.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^26.4.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "supabase": "^2.115.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.11"
  }
}
